{
  "name": "coc-session-journal",
  "productName": "COC 跑团记录簿",
  "version": "0.8.1",
  "author": "COC 跑团记录簿",
  "description": "本地 COC 跑团记录与调查员角色卡管理应用",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "release:manifest": "node scripts/release-manifest.cjs",
    "licenses": "node scripts/licenses.cjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "pnpm build && node scripts/package.cjs",
    "package:setup": "pnpm build && node scripts/package-setup.cjs",
    "lint": "eslint src tests",
    "format": "prettier --write src tests scripts *.json *.md",
    "format:check": "prettier --check src tests scripts *.json *.md",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm test"
  },
  "build": {
    "appId": "local.coc.session-journal",
    "productName": "COC跑团记录簿",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.d.cts",
      "!node_modules/**/*.d.mts",
      "!node_modules/**/*.ts",
      "!node_modules/**/*.cts",
      "!node_modules/**/*.mts",
      "!node_modules/**/*.md",
      "!node_modules/**/prebuilds/android-*/**",
      "!node_modules/**/prebuilds/ios-*/**",
      "!node_modules/**/prebuilds/darwin-*/**",
      "!node_modules/**/prebuilds/linux-*/**",
      "!node_modules/**/prebuilds/freebsd-*/**",
      "!node_modules/**/prebuilds/win32-arm64/**",
      "!node_modules/docx/dist/index.iife.js",
      "!node_modules/docx/dist/index.umd.cjs",
      "!node_modules/xlsx/formats.png",
      "!node_modules/xlsx/dist/xlsx.full.min.js",
      "!node_modules/xlsx/dist/xlsx.extendscript.js",
      "!node_modules/xlsx/dist/xlsx.core.min.js",
      "!node_modules/xlsx/dist/xlsx.mini.min.js",
      "!node_modules/xlsx/dist/cpexcel.full.mjs",
      "!node_modules/xlsx/dist/xlsx.zahl.js",
      "!node_modules/xlsx/dist/xlsx.zahl.mjs"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "COC跑团记录簿-${version}-win-x64.${ext}"
    },
    "portable": {
      "artifactName": "COC跑团记录簿-${version}-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "COC跑团记录簿",
      "artifactName": "COC跑团记录簿-${version}-Windows-x64-Setup.${ext}"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "archiver": "8.0.0",
    "docx": "9.7.1",
    "unzipper": "0.12.5",
    "xlsx": "0.18.5",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.63.0",
    "@types/archiver": "8.0.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/unzipper": "0.10.11",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "38.8.6",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.35.0",
    "playwright": "1.63.0",
    "prettier": "3.6.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.43.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
